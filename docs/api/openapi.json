  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "user_role": {
            "$ref": "#/components/schemas/UserRole",
