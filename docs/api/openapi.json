              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "task_id",
          "artifact_type",
          "version",
          "content",
          "confidence",
          "created_at"
        ],
        "title": "ArtifactRead"
      },
