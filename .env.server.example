# Copy to .env on the deployment host. Never commit the filled file.
APP_ENV=production
APP_VERSION=0.1.0
APP_DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000
SERVER_BIND_ADDRESS=127.0.0.1

# Production authentication. Use long random values for secrets.
AUTH_REQUIRED=true
AUTH_ALLOW_REGISTRATION=false
AUTH_ALLOW_GUEST=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_GUEST_SIGNING_KEY=

# Container-internal service addresses.
POSTGRES_DB=xzd
POSTGRES_USER=xzd_user
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+asyncpg://xzd_user:replace-with-a-random-password@postgres:5432/xzd
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=xzd_minio
MINIO_SECRET_KEY=replace-with-a-random-password
MINIO_BUCKET=xzd-files
QDRANT_MODE=server
QDRANT_URL=http://qdrant:6333

# Production uses the Redis queue: one API service and one queue worker.
TASK_EXECUTOR_MODE=redis
TASK_QUEUE_NAME=xzd:tasks
TASK_QUEUE_BLOCK_TIMEOUT_SECONDS=5
TASK_WORKER_RECOVERY_INTERVAL_SECONDS=15
TASK_WORKER_LOCK_TTL_SECONDS=120

# Fail closed: no Mock answer and no Spark-first route in the server overlay.
ALLOW_MOCK_FALLBACK=false
ALLOW_AGENT_MOCKS=false
IFLYTEK_SPARK_ENABLED=false
ENABLE_SPARK_REASONER=false
DASHSCOPE_ENABLED=true
ENABLE_QWEN_TEXT_FAST=true
ENABLE_QWEN_VISION_FAST=true
ENABLE_QWEN_VISION_PRIMARY=true
ENABLE_QWEN_BRIEF=true
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
QWEN_TEXT_FAST_MODEL=qwen3.8-flash
QWEN_VISION_FAST_MODEL=qwen3.8-flash
QWEN_VISION_PRIMARY_MODEL=qwen3.8-max
QWEN_BRIEF_MODEL=qwen3.7-flash
QWEN_TIMEOUT_SECONDS=90
QWEN_WARMUP_ENABLED=true
QWEN_WARMUP_TIMEOUT_SECONDS=45
QWEN_MAX_CONCURRENCY=4

# Production runtime safety.
ENABLE_DEBUG_API=false
RAG_DEBUG_ENABLED=false
LOCAL_STORAGE_FALLBACK=false
LANGGRAPH_CHECKPOINT_ENABLED=false
LANGGRAPH_CHECKPOINT_BACKEND=disabled

# Read-only course material mounts on the host. Set each path explicitly.
KNOWLEDGE_CT_HOST_PATH=/srv/xinzhi-daoxue/knowledge/CT
KNOWLEDGE_AE_HOST_PATH=/srv/xinzhi-daoxue/knowledge/AE
KNOWLEDGE_DE_HOST_PATH=/srv/xinzhi-daoxue/knowledge/DE
KNOWLEDGE_SS_HOST_PATH=/srv/xinzhi-daoxue/knowledge/SS
KNOWLEDGE_DSP_HOST_PATH=/srv/xinzhi-daoxue/knowledge/DSP
KNOWLEDGE_COMM_HOST_PATH=/srv/xinzhi-daoxue/knowledge/COMM
