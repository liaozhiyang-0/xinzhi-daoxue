{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xinzhi Evaluation Case",
  "type": "object",
  "required": ["case_id", "title", "course", "task_family", "intent", "message", "expected_agent"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "course": {"type": "string"},
    "task_family": {"type": "string"},
    "intent": {"type": "string"},
    "message": {"type": "string"},
    "expected_agent": {"type": "string"},
    "task_options": {"type": "object"},
    "official_scoring": {"type": "boolean"},
    "student_attempt_parsed": {"type": ["boolean", "null"]},
    "teaching_mode_respected": {"type": ["boolean", "null"]},
    "solution_packet_valid": {"type": ["boolean", "null"]},
    "skill_mapping_valid": {"type": ["boolean", "null"]},
    "evidence_packet_valid": {"type": ["boolean", "null"]},
    "error_pool_match_valid": {"type": ["boolean", "null"]},
    "answer_disclosure_compliant": {"type": ["boolean", "null"]},
    "requires_manual_review": {"type": ["boolean", "null"]},
    "expected_teaching_execution_path": {"type": ["string", "null"]},
    "verification_report_valid": {"type": ["boolean", "null"]},
    "expected_verification_status": {"type": ["string", "null"]},
    "expected_error_type": {"type": ["string", "null"]},
    "expected_hint_level": {"type": ["string", "null"]},
    "expected_disclosure_mode": {"type": ["string", "null"]},
    "next_check_valid": {"type": ["boolean", "null"]},
    "solution_packet_reused": {"type": ["boolean", "null"]},
    "full_solution_disclosed": {"type": ["boolean", "null"]},
    "no_additional_model_calls": {"type": ["boolean", "null"]},
    "first_confirmed_error_found": {"type": ["boolean", "null"]},
    "cross_user_isolated": {"type": ["boolean", "null"]},
    "expected_skill_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reference_solution": {"type": "object"},
    "rubric": {"$ref": "evaluation_rubric.schema.json"},
    "judge_type": {"enum": ["rule", "human", "model", "hybrid"]},
    "provenance": {
      "type": "object",
      "properties": {
        "source_type": {"enum": ["synthetic", "licensed", "private", "public"]},
        "publishable": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": true
}
