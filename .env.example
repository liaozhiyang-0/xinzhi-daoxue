APP_NAME=xinzhi-daoxue-api
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=true
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
# APP_HOST/APP_PORT serve the orchestration contract; API_HOST/API_PORT remain
# the launcher-compatible names during the deprecation window.
APP_HOST=127.0.0.1
APP_PORT=8000

# Authentication: local development keeps legacy UI compatibility; production must set true.
AUTH_REQUIRED=false
AUTH_ALLOW_REGISTRATION=true
AUTH_ALLOW_GUEST=true
AUTH_GUEST_TTL_SECONDS=86400
# Production must use a long random value; never commit the real key.
AUTH_GUEST_SIGNING_KEY=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCKOUT_SECONDS=900

DATABASE_URL=postgresql+asyncpg://xzd_user:xzd_password@postgres:5432/xzd
HOST_DATABASE_URL=postgresql+asyncpg://xzd_user:xzd_password@localhost:5432/xzd
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db
POSTGRES_DB=xzd
POSTGRES_USER=xzd_user
POSTGRES_PASSWORD=xzd_password

REDIS_URL=redis://redis:6379/0
HOST_REDIS_URL=redis://localhost:6379/0
VECTOR_STORE_PATH=./knowledge_indexes
UPLOAD_DIR=./local_storage/uploads
CACHE_DIR=./local_storage/cache
# V2 科研分析：原始附件仍由文件服务管理，以下目录只存任务隔离的临时副本和 Artifact。
RESEARCH_ANALYSIS_ARTIFACT_ROOT=./.local_outputs/research_analysis
RESEARCH_ANALYSIS_TEMP_ROOT=./.local_outputs/research_analysis_tmp
# 可选模型辅助解释：只解释本地计算事实，不替代统计计算；不可用时自动回退本地结果
RESEARCH_ANALYSIS_MODEL_ASSIST_ENABLED=true
RESEARCH_ANALYSIS_MODEL_ASSIST_MAX_TOKENS=900
# 模型主导分析：优先直接调用 Qwen，失败时按路由尝试 Spark；本地代码只作安全回退
RESEARCH_ANALYSIS_MODEL_DIRECT_ENABLED=true
RESEARCH_ANALYSIS_MODEL_DIRECT_MAX_TOKENS=2400
RESEARCH_ANALYSIS_MODEL_INPUT_MAX_CHARS=80000
EVALUATION_ATTACHMENT_CLEANUP_GRACE_SECONDS=86400

# ==========================================
# 国产模型 API（只需填写下面两个 Key）
# ==========================================
IFLYTEK_SPARK_ENABLED=true
IFLYTEK_SPARK_API_KEY=
IFLYTEK_SPARK_BASE_URL=https://spark-api-open.xf-yun.com/x2
IFLYTEK_SPARK_MODEL=spark-x
IFLYTEK_SPARK_TIMEOUT_SECONDS=120
IFLYTEK_SPARK_MAX_TOKENS=8192
IFLYTEK_SPARK_THINKING_MODE=auto

DASHSCOPE_ENABLED=true
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
QWEN_VISION_PRIMARY_MODEL=qwen3.7-plus
QWEN_VISION_FAST_MODEL=qwen3.6-flash
QWEN_TEXT_FAST_MODEL=qwen3.5-flash
QWEN_TIMEOUT_SECONDS=90
QWEN_VISION_HIGH_RESOLUTION=true

MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=1
MODEL_GLOBAL_MAX_CONCURRENCY=6
# Provider 明确不可用后短时熔断，避免每道题重复等待同一超时。
MODEL_CIRCUIT_FAILURE_THRESHOLD=1
MODEL_CIRCUIT_RESET_SECONDS=300
SPARK_MAX_CONCURRENCY=4
QWEN_MAX_CONCURRENCY=2
VISION_MAX_CONCURRENCY=2
ENABLE_MODEL_COST_TRACKING=true
ACADEMIC_SOLVER_MAX_TOKENS=4096
# 达到输出上限、公式未闭合或复杂题未完成全部小问时续答。
ACADEMIC_SOLVER_MAX_CONTINUATIONS=2
# 8192-token 长题可能超过普通分类/视觉模型的默认超时。
ACADEMIC_SOLVER_TIMEOUT_SECONDS=240
ACADEMIC_SOLVER_RETRIEVAL_TIMEOUT_SECONDS=30
ACADEMIC_SOLVER_VISION_TIMEOUT_SECONDS=60
ACADEMIC_SOLVER_MIN_GENERATION_SECONDS=90
MULTI_IMAGE_PRESERVE_ORIGINALS=true
# 请求级预算：软截止后不再启动可选调用，最终整理和硬截止前保留已有答案。
ACADEMIC_SOLVER_SOFT_DEADLINE_SECONDS=140
ACADEMIC_SOLVER_FINALIZATION_DEADLINE_SECONDS=165
ACADEMIC_SOLVER_HARD_DEADLINE_SECONDS=175
# 复杂题（含视觉、多图、长文本或高风险结构）才使用扩展预算；
# 预留最后 5 秒给任务持久化，使评测器可在 240 秒内取得终态。
ACADEMIC_SOLVER_COMPLEX_SOFT_DEADLINE_SECONDS=200
ACADEMIC_SOLVER_COMPLEX_FINALIZATION_DEADLINE_SECONDS=225
ACADEMIC_SOLVER_COMPLEX_HARD_DEADLINE_SECONDS=235

# External academic/web retrieval. Results are bounded by an in-process TTL/LRU cache.
EXTERNAL_RETRIEVAL_ENABLED=true
EXTERNAL_RETRIEVAL_INTENT_GATE_ENABLED=true
EXTERNAL_RETRIEVAL_TIMEOUT_SECONDS=120
EXTERNAL_RETRIEVAL_REVIEW_ENABLED=true
EXTERNAL_RETRIEVAL_PROVIDER_RETRIES=1
EXTERNAL_RETRIEVAL_MAX_PROVIDER_CONCURRENCY=4
EXTERNAL_RETRIEVAL_MAX_QUERY_VARIANTS=2
EXTERNAL_RETRIEVAL_RATE_LIMIT_COOLDOWN_SECONDS=60
EXTERNAL_RETRIEVAL_CACHE_SIZE=128
EXTERNAL_RETRIEVAL_CACHE_TTL_SECONDS=120
EXTERNAL_RETRIEVAL_MAX_RESULTS=8
EXTERNAL_RETRIEVAL_MAX_FETCHES=4
EXTERNAL_RETRIEVAL_ALLOW_FULL_TEXT=false
EXTERNAL_ARXIV_MIN_DELAY_SECONDS=3
EXTERNAL_ARXIV_TIMEOUT_SECONDS=8
EXTERNAL_ARXIV_MAX_CONCURRENCY=1
EXTERNAL_OPENALEX_BASE_URL=https://api.openalex.org
EXTERNAL_OPENALEX_API_KEY=
EXTERNAL_OPENALEX_MAILTO=
EXTERNAL_OPENALEX_MIN_DELAY_SECONDS=0.5
EXTERNAL_OPENALEX_TIMEOUT_SECONDS=15
EXTERNAL_OPENALEX_MAX_CONCURRENCY=2
EXTERNAL_CROSSREF_BASE_URL=https://api.crossref.org
EXTERNAL_CROSSREF_MAILTO=
EXTERNAL_CROSSREF_MIN_DELAY_SECONDS=0.5
EXTERNAL_CROSSREF_TIMEOUT_SECONDS=12
EXTERNAL_CROSSREF_MAX_CONCURRENCY=1
EXTERNAL_SEMANTIC_SCHOLAR_MIN_DELAY_SECONDS=1
EXTERNAL_SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=30
EXTERNAL_SEMANTIC_SCHOLAR_MAX_CONCURRENCY=1
EXTERNAL_SEMANTIC_SCHOLAR_ALLOW_UNAUTHENTICATED=false

# Generic JSON gateway. Keep empty until a compatible gateway is available.
EXTERNAL_WEB_SEARCH_BASE_URL=
EXTERNAL_WEB_SEARCH_API_KEY=
EXTERNAL_WEB_SEARCH_AUTH_HEADER=x-api-key
EXTERNAL_WEB_SEARCH_TIMEOUT_SECONDS=15

# Tavily: https://app.tavily.com/ ; POST /search with Bearer auth.
EXTERNAL_TAVILY_BASE_URL=https://api.tavily.com/search
EXTERNAL_TAVILY_API_KEY=
EXTERNAL_TAVILY_AUTH_HEADER=Authorization
EXTERNAL_TAVILY_AUTH_SCHEME=Bearer
EXTERNAL_TAVILY_SEARCH_DEPTH=basic
EXTERNAL_TAVILY_TOPIC=general
EXTERNAL_TAVILY_INCLUDE_ANSWER=false
EXTERNAL_TAVILY_INCLUDE_RAW_CONTENT=false
EXTERNAL_TAVILY_MIN_DELAY_SECONDS=1
EXTERNAL_TAVILY_TIMEOUT_SECONDS=30
EXTERNAL_TAVILY_MAX_RESULTS=5
EXTERNAL_TAVILY_MAX_CONCURRENCY=1

# Brave Search: https://brave.com/search/api/
EXTERNAL_BRAVE_BASE_URL=https://api.search.brave.com/res/v1/web/search
EXTERNAL_BRAVE_API_KEY=
EXTERNAL_BRAVE_AUTH_HEADER=X-Subscription-Token
EXTERNAL_BRAVE_COUNTRY=CN
EXTERNAL_BRAVE_SEARCH_LANG=zh
EXTERNAL_BRAVE_MIN_DELAY_SECONDS=1
EXTERNAL_BRAVE_TIMEOUT_SECONDS=30
EXTERNAL_BRAVE_MAX_RESULTS=5
EXTERNAL_BRAVE_MAX_CONCURRENCY=1

# SerpApi: https://serpapi.com/ ; API key is sent as a query parameter.
EXTERNAL_SERPAPI_BASE_URL=https://serpapi.com/search.json
EXTERNAL_SERPAPI_API_KEY=
EXTERNAL_SERPAPI_ENGINE=google
EXTERNAL_SERPAPI_MIN_DELAY_SECONDS=1
EXTERNAL_SERPAPI_TIMEOUT_SECONDS=30
EXTERNAL_SERPAPI_MAX_RESULTS=5
EXTERNAL_SERPAPI_MAX_CONCURRENCY=1

# Self-hosted SearXNG: https://docs.searxng.org/admin/installation-docker
# Example endpoint: http://127.0.0.1:8080/search
EXTERNAL_SEARXNG_BASE_URL=
EXTERNAL_SEARXNG_API_KEY=
EXTERNAL_SEARXNG_FORMAT=json
EXTERNAL_SEARXNG_CATEGORIES=general
EXTERNAL_SEARXNG_LANGUAGE=zh-CN
EXTERNAL_SEARXNG_MIN_DELAY_SECONDS=1
EXTERNAL_SEARXNG_TIMEOUT_SECONDS=30
EXTERNAL_SEARXNG_MAX_RESULTS=5
EXTERNAL_SEARXNG_MAX_CONCURRENCY=1

# Alibaba UnifiedSearch: https://help.aliyun.com/zh/document_detail/2963346.html
# Leave the key blank until the adapter is enabled.
EXTERNAL_ALIYUN_IQS_BASE_URL=https://cloud-iqs.aliyuncs.com/search/unified
EXTERNAL_ALIYUN_IQS_API_KEY=
EXTERNAL_ALIYUN_IQS_ENGINE_TYPE=Generic
EXTERNAL_ALIYUN_IQS_TIME_RANGE=NoLimit
EXTERNAL_ALIYUN_IQS_MIN_DELAY_SECONDS=1
EXTERNAL_ALIYUN_IQS_TIMEOUT_SECONDS=30
EXTERNAL_ALIYUN_IQS_MAX_RESULTS=5
EXTERNAL_ALIYUN_IQS_MAX_CONCURRENCY=1

# Bocha AI Search: https://open.bochaai.com/
# Leave the key blank until the adapter is enabled.
EXTERNAL_BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search
EXTERNAL_BOCHA_API_KEY=
EXTERNAL_BOCHA_AUTH_HEADER=Authorization
EXTERNAL_BOCHA_AUTH_SCHEME=Bearer
EXTERNAL_BOCHA_FRESHNESS=noLimit
EXTERNAL_BOCHA_SUMMARY=true
EXTERNAL_BOCHA_MIN_DELAY_SECONDS=1
EXTERNAL_BOCHA_TIMEOUT_SECONDS=30
EXTERNAL_BOCHA_MAX_RESULTS=5
EXTERNAL_BOCHA_MAX_CONCURRENCY=1

EXTERNAL_NEWS_RSS_BASE_URL=https://news.google.com/rss/search
EXTERNAL_NEWS_RSS_TIMEOUT_SECONDS=15
EXTERNAL_NEWS_RSS_MIN_DELAY_SECONDS=1
EXTERNAL_NEWS_RSS_MAX_CONCURRENCY=1
RESEARCH_KNOWLEDGE_ENABLED=true
RESEARCH_KNOWLEDGE_MAINTENANCE_ENABLED=true
RESEARCH_KNOWLEDGE_MAINTENANCE_INTERVAL_SECONDS=86400
RESEARCH_KNOWLEDGE_RETENTION_DAYS=1095
RESEARCH_KNOWLEDGE_SEARCH_TOP_K=8

# Task lease/recovery. Recovery claims queued work before dispatching it.
TASK_EXECUTOR_MODE=local
TASK_QUEUE_NAME=xzd:tasks
TASK_QUEUE_BLOCK_TIMEOUT_SECONDS=5
TASK_WORKER_RECOVERY_INTERVAL_SECONDS=15
TASK_WORKER_LOCK_TTL_SECONDS=120
# Poison dispatch messages are requeued up to this many attempts before moving
# to the Redis dead-letter list. The database lease remains the source of truth
# for crash recovery, so this only guards against tight redelivery loops.
TASK_QUEUE_DEAD_LETTER_ENABLED=true
TASK_QUEUE_DEAD_LETTER_MAX_ATTEMPTS=3
# Docker defaults to the CPU Torch wheel. Override these only for an
# intentional GPU-enabled image build.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_REQUIREMENT=torch>=2.7,<3
TASK_LEASE_SECONDS=120
TASK_RECOVERY_ENABLED=true
# All registered Agents execute through the durable Runtime. There are no
# per-Agent execution gates or Legacy launch modes.
AGENT_RUNTIME_PLAN_PROPOSALS_ENABLED=false
# Optional side-effect capability allowlist for explicit Goal Runtime plans.
# Format: AGENT_ID=handler.one|handler.two;OTHER_AGENT=handler.three
AGENT_RUNTIME_GOAL_CAPABILITIES=
# Optional release-readiness evidence. It does not switch execution engines.
# Format: AGENT_ID=PATH[,AGENT_ID=PATH]
AGENT_RUNTIME_CANARY_ARTIFACTS=
# Optional semantic review sidecars. When configured for an Agent, its
# readiness review also requires decision=pass. Format: AGENT_ID=PATH
AGENT_RUNTIME_SEMANTIC_EVIDENCE=
# Separate, version-bound human approval records for readiness review.
# Format: AGENT_ID=PATH[,AGENT_ID=PATH].
AGENT_RUNTIME_RELEASE_AUTHORIZATIONS=
AGENT_RUNTIME_RELEASE_GATE_REQUIRED=true
# Registered Runtime paths are always enabled; no Runtime profile is required.

UPLOAD_MAX_IMAGE_SIZE_MB=6
UPLOAD_MAX_IMAGES=8
IMAGE_MAX_LONG_EDGE=4096
IMAGE_AUTO_ROTATE=true
IMAGE_REMOVE_EXIF=true
# 多图优先拼接；超过数量、像素或宽高比阈值时改为逐图识别再汇总。
MULTI_IMAGE_STITCH_MAX_IMAGES=4
MULTI_IMAGE_STITCH_MAX_TOTAL_PIXELS=16000000
MULTI_IMAGE_STITCH_MAX_CANVAS_EDGE=4096
MULTI_IMAGE_STITCH_MAX_ASPECT_RATIO=4
MULTI_IMAGE_FALLBACK_CONCURRENCY=2
MULTI_IMAGE_SUMMARY_MAX_CHARS=24000

ENABLE_SPARK_REASONER=true
ENABLE_QWEN_TEXT_FAST=true
ENABLE_QWEN_VISION_FAST=true
ENABLE_QWEN_VISION_PRIMARY=true
ENABLE_DUAL_MODEL_VERIFICATION=true
DUAL_MODEL_MIN_RISK_LEVEL=high
# 第二阶段学生过程核对默认仅使用确定性规则；当前实现不会调用裁判模型。
STUDENT_VERIFICATION_MODEL_ENABLED=false

# 旧 SPARK_* 变量只用于兼容既有本机配置；新部署使用 IFLYTEK_SPARK_*。
SPARK_ENABLED=false
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_API_PASSWORD=
SPARK_MODEL=4.0Ultra
SPARK_TIMEOUT_SECONDS=90

MINIO_ENDPOINT=minio:9000
HOST_MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=xzd_minio
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=xzd-files
MINIO_SECURE=false

DEFAULT_AGENT_PROVIDER=mock
ALLOW_MOCK_FALLBACK=true
# 仅development/test有效；production会被代码强制禁用。
ALLOW_AGENT_MOCKS=false
AGENT_MOCK_PROFILES_PATH=./agent_configs/mock_profiles.yaml
AGENT_MOCK_MAX_LATENCY_MS=100

WORKFLOW_DEFAULT_TIMEOUT_SECONDS=120
WORKFLOW_MAX_RETRIES=1

MAX_UPLOAD_SIZE_MB=20
DOCUMENT_MAX_FILES_PER_TASK=8
DOCUMENT_MAX_PAGES=200
DOCUMENT_MAX_EXTRACTED_CHARS=80000
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=160
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=30
DOCUMENT_CONVERTER_COMMAND=soffice
STUDENT_IMAGE_MAX_SIZE_MB=8
STUDENT_UPLOAD_TTL_SECONDS=3600
STUDENT_CONVERSATION_SUMMARY_CHARS=800
STUDENT_PREVIOUS_ANSWER_CHARS=600
LOCAL_STORAGE_FALLBACK=true
LOCAL_STORAGE_PATH=./local_storage
SSE_HEARTBEAT_SECONDS=10

# 本地知识库只读挂载。Docker 启动脚本会优先自动发现仓库内或相邻仓库的
# “电路理论 / 模电 / 数电 / 信号与系统版本一 / 数字信号处理 / 通信原理”
# 目录；以下目录是无资料时的安全空目录回退。
KNOWLEDGE_ENABLED=true
# 可选：脚本自动发现失败时取消注释并填写宿主机绝对路径。
# KNOWLEDGE_CT_HOST_PATH=C:/absolute/path/to/电路理论
# KNOWLEDGE_AE_HOST_PATH=C:/absolute/path/to/模电
# KNOWLEDGE_DE_HOST_PATH=C:/absolute/path/to/数电
# KNOWLEDGE_SS_HOST_PATH=C:/absolute/path/to/信号与系统版本一
# KNOWLEDGE_DSP_HOST_PATH=C:/absolute/path/to/数字信号处理
# KNOWLEDGE_COMM_HOST_PATH=C:/absolute/path/to/通信原理
KNOWLEDGE_CT_PATH=./local_knowledge/CT
KNOWLEDGE_AE_PATH=./local_knowledge/AE
KNOWLEDGE_DE_PATH=./local_knowledge/DE
KNOWLEDGE_SS_PATH=./local_knowledge/SS
KNOWLEDGE_DSP_PATH=./local_knowledge/DSP
KNOWLEDGE_COMM_PATH=./local_knowledge/COMM
KNOWLEDGE_CHUNK_SIZE_CHARS=400
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_DEFAULT_TOP_K=5
KNOWLEDGE_MAX_FILES_PER_COURSE=1000
KNOWLEDGE_MAX_FILE_SIZE_MB=5
KNOWLEDGE_INDEX_PATH=./knowledge_indexes
KNOWLEDGE_OCR_REVIEW_CACHE_ENABLED=true
KNOWLEDGE_OCR_REVIEW_CACHE_PATH=./.local_outputs/ocr_review_snapshots
KNOWLEDGE_OCR_REVIEW_CACHE_TTL_SECONDS=300
KNOWLEDGE_KEYWORD_WEIGHT=1.0
KNOWLEDGE_IMAGE_CONTEXT_WEIGHT=0.4

# Multimodal RAG. Production never falls back to hash/random embeddings.
RAG_ENABLED=true
# 启动完成前加载文本与图片检索模型，避免首个学生请求承担模型冷启动。
RAG_WARMUP_ON_STARTUP=true
RAG_WARMUP_IMAGE_MODEL=true
# 默认查询未启用大 Reranker，因此不在启动时额外占用内存。
RAG_WARMUP_RERANKER=false
# true 会在任一必需模型预热失败时阻止 API 启动。
RAG_WARMUP_STRICT=false
TEXT_EMBEDDING_PROVIDER=local_bge
TEXT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 运行时默认只读取已缓存模型，避免网络探测与重试耗尽检索预算。
# 仅在明确执行模型首次下载/更新时临时设为 false。
RAG_MODEL_LOCAL_FILES_ONLY=true
TEXT_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
TEXT_EMBEDDING_DEVICE=auto
TEXT_EMBEDDING_BATCH_SIZE=8
TEXT_EMBEDDING_NORMALIZE=true
TEXT_EMBEDDING_MAX_LENGTH=1024
# TEXT_EMBEDDING_CACHE_DIR=C:/model-cache
TEXT_EMBEDDING_TRUST_REMOTE_CODE=false
# 当前默认索引由bge-small-zh-v1.5构建；若重建为其他模型，必须同步更新模型、revision和集合。
TEXT_EMBEDDING_QUERY_INSTRUCTION=
TEXT_COLBERT_ENABLED=false
LEGACY_HASH_EMBEDDING_ENABLED=true
LEGACY_HASH_EMBEDDING_DIMENSION=384

IMAGE_EMBEDDING_ENABLED=true
IMAGE_EMBEDDING_PROVIDER=local_siglip2
IMAGE_EMBEDDING_MODEL=google/siglip2-base-patch16-224
IMAGE_EMBEDDING_REVISION=main
IMAGE_EMBEDDING_DEVICE=auto
IMAGE_EMBEDDING_BATCH_SIZE=4
IMAGE_EMBEDDING_NORMALIZE=true
# IMAGE_EMBEDDING_CACHE_DIR=C:/model-cache
IMAGE_CAPTION_EMBEDDING_ENABLED=true

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=main
RERANKER_DEVICE=auto
RERANKER_TOP_N=20
RERANKER_OUTPUT_K=5

VECTOR_STORE_PROVIDER=qdrant
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
HOST_QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TRUST_ENV=false
QDRANT_LOCAL_PATH=./knowledge_indexes/qdrant
QDRANT_TEXT_COLLECTION=xinzhi_kb_text_v2
QDRANT_IMAGE_COLLECTION=xinzhi_kb_image_v2
QDRANT_RESEARCH_COLLECTION=xinzhi_research_evidence_v1
LANGGRAPH_CHECKPOINT_ENABLED=true
LANGGRAPH_CHECKPOINT_BACKEND=memory

RAG_DENSE_CANDIDATE_K=20
RAG_SPARSE_CANDIDATE_K=20
RAG_IMAGE_CANDIDATE_K=12
RAG_FINAL_TEXT_K=5
RAG_FINAL_IMAGE_K=3
RAG_RRF_K=60
RAG_QUERY_CACHE_SIZE=256
RAG_RESULT_CACHE_SIZE=128
RAG_RESULT_CACHE_TTL_SECONDS=300
# CPU低延迟默认关闭大Reranker；Debug页面或单次请求可显式开启。
RAG_DEFAULT_USE_RERANKER=false
TEXT_EMBEDDING_CONCURRENCY_LIMIT=2
IMAGE_EMBEDDING_CONCURRENCY_LIMIT=1
RERANKER_CONCURRENCY_LIMIT=1
RERANKER_CONDITIONAL_SCORE_GAP=0.01
RAG_RETRIEVAL_WORKER_COUNT=2
RAG_CHUNKER_VERSION=semantic_v2
RAG_CLEANING_VERSION=clean_v1
RAG_SCHEMA_VERSION=2

# RAG Debug 写接口在 production 环境始终关闭。
RAG_DEBUG_ENABLED=true
RAG_DEBUG_MAX_INPUT_CHARS=2000
RAG_DEBUG_TRACE_MAX_RECORDS=100
RAG_DEBUG_TRACE_TTL_SECONDS=3600

ENABLE_DEBUG_API=true
ENABLE_EVALUATION_API=false
ENABLE_LOCAL_KNOWLEDGE_QA=true
ENABLE_LOCAL_SOLVER_CT=false
# 多模态本地拆分限制。专用图像 Provider 未验证前保持关闭；已验证的
# 单图视觉链路不受影响。
VISION_ENABLED=false
VISION_ENDPOINT=
VISION_MAX_CONCURRENCY=2
VISION_MAX_IMAGES_PER_REQUEST=8
PDF_MAX_SIZE_MB=20
PDF_MAX_PAGES=40
PDF_RENDER_DPI=144
PDF_MAX_CONCURRENCY=2
TEMPORARY_FILE_TTL_SECONDS=3600
# Agent runtime conversation context (token counts are conservative estimates).
CONTEXT_MAX_INPUT_TOKENS=16000
CONTEXT_RESERVED_OUTPUT_TOKENS=4096
CONTEXT_COMPACTION_TRIGGER_RATIO=0.70
CONTEXT_RECENT_MESSAGE_LIMIT=12
CONTEXT_RELEVANT_OLDER_LIMIT=6
CONTEXT_MEMORY_LIMIT=8
CONTEXT_SUMMARY_TARGET_TOKENS=1200
CONTEXT_SUMMARY_MESSAGE_TRIGGER=24
CONTEXT_CACHE_TTL_SECONDS=300
CONTEXT_CACHE_MAX_ENTRIES=256
CONTEXT_CONFIG_VERSION=conversation-v1
