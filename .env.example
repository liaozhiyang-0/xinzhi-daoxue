APP_NAME=xinzhi-daoxue-api
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://xzd_user:xzd_password@postgres:5432/xzd
HOST_DATABASE_URL=postgresql+asyncpg://xzd_user:xzd_password@localhost:5432/xzd
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db
POSTGRES_DB=xzd
POSTGRES_USER=xzd_user
POSTGRES_PASSWORD=xzd_password

REDIS_URL=redis://redis:6379/0
HOST_REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=minio:9000
HOST_MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=xzd_minio
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=xzd-files
MINIO_SECURE=false

DEFAULT_AGENT_PROVIDER=mock

XINGCHEN_ENABLED=false
XINGCHEN_BASE_URL=
XINGCHEN_API_KEY=
XINGCHEN_API_SECRET=
XINGCHEN_SOLVER_CT_FLOW_ID=
XINGCHEN_SOLVER_CT_WORKFLOW_ID=
XINGCHEN_TIMEOUT_SECONDS=120
XINGCHEN_KNOWLEDGE_QA_FLOW_ID=
XINGCHEN_FALLBACK_ROUTER_FLOW_ID=

# Local routing
LOCAL_ROUTE_CONFIDENCE_THRESHOLD=0.75

# Timeouts
XINGCHEN_SOLVER_TIMEOUT_SECONDS=180
XINGCHEN_KNOWLEDGE_TIMEOUT_SECONDS=90
XINGCHEN_ROUTER_TIMEOUT_SECONDS=30
XINGCHEN_MAX_RETRIES=0

# Local knowledge context
SOLVER_USE_LOCAL_KB_CONTEXT=true
SOLVER_KB_TOP_K=2
SOLVER_KB_MAX_CHARS=2000
KNOWLEDGE_USE_LOCAL_KB_CONTEXT=true
KNOWLEDGE_KB_TOP_K=3
KNOWLEDGE_KB_MAX_CHARS=3500

# Cache
XINGCHEN_CACHE_ENABLED=true
XINGCHEN_SOLVER_CACHE_TTL_SECONDS=1800
XINGCHEN_KNOWLEDGE_CACHE_TTL_SECONDS=3600
XINGCHEN_ROUTER_CACHE_TTL_SECONDS=600

MAX_UPLOAD_SIZE_MB=20
LOCAL_STORAGE_FALLBACK=true
LOCAL_STORAGE_PATH=./local_storage
